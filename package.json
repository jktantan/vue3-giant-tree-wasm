{
  "name": "vue3-giant-tree-wasm",
  "version": "0.2.5",
  "description": "A WebAssembly-accelerated Vue 3 virtual tree component for 100K–1M nodes: virtual scrolling, fuzzy search, checkbox/radio selection modes, and MPTT-based subtree operations.",
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "vue3-component",
    "tree",
    "treeview",
    "virtual-tree",
    "virtual-scroll",
    "virtual-list",
    "wasm",
    "webassembly",
    "assemblyscript",
    "mptt",
    "large-data",
    "million-nodes"
  ],
  "homepage": "https://jktantan.github.io/vue3-giant-tree-wasm/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktantan/vue3-giant-tree-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/jktantan/vue3-giant-tree-wasm/issues"
  },
  "license": "BSD-2-Clause",
  "author": "tantan",
  "type": "module",
  "main": "./dist/vue-giant-tree.es.js",
  "module": "./dist/vue-giant-tree.es.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "browser": "./dist/vue-giant-tree.es.js",
      "import": "./dist/vue-giant-tree.es.js",
      "default": "./dist/vue-giant-tree.es.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "asbuild:debug": "asc assembly/index.ts --debug --target debug",
    "asbuild:release": "asc assembly/index.ts  --target release",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark:phase0": "node --expose-gc scripts/benchmark-phase0.mjs",
    "benchmark:selection": "node --expose-gc scripts/benchmark-selection.mjs",
    "benchmark:visibility": "node --expose-gc scripts/benchmark-visibility.mjs",
    "benchmark:capacity": "node --expose-gc scripts/benchmark-capacity.mjs",
    "benchmark:capacity:push": "node --expose-gc scripts/benchmark-capacity.mjs --push 1000000",
    "benchmark:capacity:search-ab": "node --expose-gc scripts/benchmark-capacity.mjs --search-ab 1000000",
    "benchmark:capacity:lazy-ab": "node --expose-gc scripts/benchmark-capacity.mjs --lazy-ab 1000000",
    "benchmark:capacity:compact-ab": "node --expose-gc scripts/benchmark-capacity.mjs --compact-ab 1000000",
    "benchmark:js-ab": "bash scripts/run-benchmark-js-ab.sh",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:100k": "vitest run --config vitest.browser.config.ts --mode browser-100k",
    "profile:browser:build": "vitest run --config vitest.browser.config.ts --mode browser-build-profile",
    "report:browser": "vitest run --config vitest.browser.config.ts --mode browser-build-profile --reporter verbose",
    "report:browser:100k": "vitest run --config vitest.browser.config.ts --mode browser-100k --reporter verbose",
    "gate:phase3-4": "node scripts/run-phase3-4-gate.mjs",
    "start": "npx serve .",
    "lib:build": "vite --config vite.config.lib.ts build",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "verify:consumer": "node scripts/verify-npm-consumer.mjs",
    "prepublishOnly": "npm run lib:build && npm run verify:consumer"
  },
  "dependencies": {
    "throttle-debounce": "^5.0.2"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "as-bind": "^0.8.2",
    "assemblyscript": "^0.28.20",
    "assemblyscript-prettier": "^3.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "nanoid": "^6.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-package-version": "^1.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
